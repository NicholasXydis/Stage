$blue: $primary;
$on-blue: $text-primary;
$blue-deep: $primary-muted;
$blue-dim: $primary-darken-2;
$new: $success;
$warn: $warning;
$bad: $error;

Screen {
    background: $surface;
    overflow-y: hidden;
}

Header {
    background: $blue-deep;
    color: $on-blue;
}

HeaderIcon {
    visibility: hidden;
}

SplashScreen {
    align: center middle;
    background: $surface;
}

#splash-art {
    color: $text;
    text-style: bold;
    text-align: center;
    width: 100%;
}

#splash-stats {
    color: $text-muted;
    text-align: center;
    margin-top: 1;
    width: 100%;
}

#chips {
    height: auto;
    min-height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
    border-bottom: ascii $blue-dim;
}

#chips .active {
    color: $blue;
    text-style: bold;
}

#chips.busy {
    color: $blue;
}

#overall {
    margin: 0 1;
}

#sources {
    padding: 1;
}

#warnings {
    padding: 0 1;
    color: $warn;
}

.narrow #sources {
    padding: 0 1;
}

#filters, #picker {
    height: auto;
    max-height: 12;
    padding: 0 1;
    background: $panel;
    scrollbar-size-vertical: 1;
    border: none;
    border-bottom: ascii $blue;
}

#filters:focus, #picker:focus {
    border: none;
    border-bottom: ascii $blue;
}

#filters > .option-list--option-highlighted,
#picker > .option-list--option-highlighted {
    background: $blue-deep;
    color: $on-blue;
    text-style: bold;
}

#filters.hidden, #picker.hidden {
    display: none;
}

#results {
    height: 1fr;
    min-height: 3;
    scrollbar-size-vertical: 1;
}

#results > .datatable--header {
    background: $panel;
    color: $blue;
    text-style: bold;
}

#results > .datatable--cursor {
    background: $blue-deep;
    color: $on-blue;
    text-style: bold;
}

#results > .datatable--hover {
    background: $blue-dim;
}

DataTable {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#tabs, #tabs > ContentSwitcher, #tabs TabPane {
    height: 1fr;
}

DataTable > .datatable--cursor {
    background: $blue-deep;
    color: $on-blue;
}

DataTable > .datatable--header {
    background: $panel;
    color: $blue;
    text-style: bold;
}

#detail {
    height: 9;
    min-height: 3;
    padding: 1 2;
    background: $panel;
    border-top: ascii $blue;
}

#reader {
    height: 9;
    min-height: 3;
    padding: 1 2;
    background: $panel;
    border-top: ascii $blue;
    overflow-y: hidden;
    scrollbar-size-vertical: 1;
}

#reader.expanded {
    height: 22;
    max-height: 60%;
    overflow-y: auto;
}

#reader > #detail {
    height: auto;
    min-height: 0;
    padding: 0;
    border-top: none;
}

#detail-title {
    color: $blue;
    text-style: bold;
}

#search-bar, #note-bar {
    height: 3;
    padding: 0 1;
    display: none;
}

#search-bar.visible, #note-bar.visible {
    display: block;
}

Input {
    border: ascii $blue-dim;
}

Input:focus {
    border: ascii $blue;
}

Toast, Toast.-information, Toast.-warning, Toast.-error {
    border-left: ascii $blue;
}

Toast.-warning {
    border-left: ascii $warn;
}

Toast.-error {
    border-left: ascii $bad;
}

Underline {
    display: none;
}

Tab.-active {
    text-style: bold reverse;
}

.empty {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

#stats-grid {
    height: auto;
    padding: 1;
}

.bar {
    color: $blue;
}

.stat-label {
    color: $text-muted;
}

Footer {
    background: $panel;
}

.narrow #filters, .narrow #picker {
    max-height: 8;
}

#help {
    display: none;
}

#help.visible {
    display: block;
    layer: overlay;
    dock: top;
    width: 47;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    margin: 2 0 0 4;
    padding: 1 2;
    background: $panel;
    border: ascii $blue;
    color: $text;
}
