$blue: $primary;
$on-blue: $text-primary;
$blue-deep: $primary-muted;
$blue-dim: $primary-darken-2;
$new: $success;
$warn: $warning;
$bad: $error;

Screen {
    background: $surface;
}

Header {
    background: $blue-deep;
    color: $on-blue;
}

#splash {
    align: center middle;
    background: $surface;
}

#splash-art {
    color: $text;
    text-style: bold;
    text-align: center;
    width: auto;
}

#splash-stats {
    color: $text-muted;
    text-align: center;
    margin-top: 1;
    width: auto;
}

#chips {
    height: auto;
    min-height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
    border-bottom: solid $blue-dim;
}

#chips .active {
    color: $blue;
    text-style: bold;
}

#chips.busy {
    color: $blue;
}

#overall {
    margin: 0 1;
}

#sources {
    padding: 1;
}

#warnings {
    padding: 0 1;
    color: $warn;
}

#filters {
    height: auto;
    max-height: 12;
    padding: 0 1;
    background: $panel;
    border-bottom: solid $blue;
    scrollbar-size-vertical: 1;
}

#filters:focus {
    border-bottom: solid $blue;
}

#filters > .option-list--option-highlighted {
    background: $blue-deep;
    color: $on-blue;
    text-style: bold;
}

#filters.hidden {
    display: none;
}

#results {
    height: 1fr;
    min-height: 3;
    scrollbar-size-vertical: 1;
}

#results > .datatable--header {
    background: $panel;
    color: $blue;
    text-style: bold;
}

#results > .datatable--cursor {
    background: $blue-deep;
    color: $on-blue;
    text-style: bold;
}

#results > .datatable--hover {
    background: $blue-dim;
}

DataTable {
    height: 1fr;
}

DataTable > .datatable--cursor {
    background: $blue-deep;
    color: $on-blue;
}

DataTable > .datatable--header {
    background: $panel;
    color: $blue;
    text-style: bold;
}

#detail {
    height: 9;
    min-height: 3;
    padding: 1 2;
    background: $panel;
    border-top: solid $blue;
}

#detail.expanded {
    height: 22;
}

#detail-title {
    color: $blue;
    text-style: bold;
}

#search-bar {
    height: 3;
    padding: 0 1;
    display: none;
}

#search-bar.visible {
    display: block;
}

Input {
    border: tall $blue-dim;
}

Input:focus {
    border: tall $blue;
}

.empty {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

#stats-grid {
    height: 1fr;
    padding: 1;
}

.bar {
    color: $blue;
}

.stat-label {
    color: $text-muted;
}

Footer {
    background: $panel;
}

.narrow #filters {
    max-height: 8;
}

#help {
    display: none;
}

#help.visible {
    display: block;
    layer: overlay;
    dock: top;
    width: 46;
    height: auto;
    margin: 2 0 0 4;
    padding: 1 2;
    background: $panel;
    border: round $blue;
    color: $text;
}
